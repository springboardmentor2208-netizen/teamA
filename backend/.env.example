# ---------------- Server Configuration ----------------
PORT=5000

# ---------------- MongoDB Database ----------------
# Add your MongoDB connection URI here
MONGO_URI=your_mongodb_connection_string_here

# ---------------- Authentication Secrets ----------------
# Add your JWT secret key
JWT_SECRET=SECRET12345

# Add your session secret
SESSION_SECRET=SECRET12345

# ---------------- Google OAuth ----------------
# Add your Google OAuth credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ---------------- Cloudinary Configuration ----------------
# Add your Cloudinary credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ---------------- Admin Access ----------------
# Add your admin secret key
ADMIN_SECRET_KEY=ADMIN12345

# ---------------- Email Configuration ----------------
# Add your email credentials for sending OTP
EMAIL_USER=your_email_address_here
EMAIL_PASS=your_email_app_password_here

# OTP expiry time in minutes
OTP_EXPIRY_MINUTES=5

# ---------------- Frontend URL (Development) ----------------
CLIENT_URL=http://localhost:5173

# ---------------- Backend URL (Development) ----------------
BASE_URL=http://localhost:5000